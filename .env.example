# G DESIGN environment configuration.
# Copy to .env and adjust. NEVER commit the real .env.

APP_ENV=local
APP_URL=http://127.0.0.1:8000
API_URL=http://127.0.0.1:8000/api/v1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gdesign
DB_USER=gdesign
DB_PASSWORD=

# Comma-separated list of absolute origins allowed to call the API cross-origin.
# Empty = same-origin only (recommended for production). Wildcard "*" is not supported.
ALLOWED_ORIGINS=
