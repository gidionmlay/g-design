# G DESIGN environment configuration.
# Copy to .env and adjust. NEVER commit the real .env.

APP_ENV=local
APP_URL=http://127.0.0.1:8000
API_URL=http://127.0.0.1:8000/api/v1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gdesign
DB_USER=gdesign
DB_PASSWORD=

# Comma-separated list of absolute origins allowed to call the API cross-origin.
# Empty = same-origin only (recommended for production). Wildcard "*" is not supported.
ALLOWED_ORIGINS=

# Admin seeder (database/seed_admin.php) — read from environment, never committed.
# Provide real values when running the seed; leave blank to use defaults.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_NAME=G DESIGN Administrator
# ADMIN_PASSWORD=   # required; no default — supply at seed time (e.g. ADMIN_PASSWORD=... php database/seed_admin.php)
